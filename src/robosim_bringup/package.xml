<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robosim_bringup</name>
  <version>1.0.1</version>
  <description>This package is responsible for launching Robot Simulation and it's teleoperation system together in one process.</description>
  <maintainer email="akmaly255@gmail.com">Akmal Y</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <exec_depend>robosim_simulation</exec_depend>
  <exec_depend>robosim_teleop</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
