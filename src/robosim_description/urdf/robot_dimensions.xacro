<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  
  <!-- Robot dimensions -->
  <xacro:property name="body_height" value="0.10" />
  <xacro:property name="body_length" value="0.35" />
  <xacro:property name="body_width" value="0.23" />

  <xacro:property name="wheel_radius" value="0.07" />
  <xacro:property name="wheel_width" value="0.03" />

  <xacro:property name="caster_radius" value="0.02" />

  <xacro:property name="pan_radius" value="0.03" />
  <xacro:property name="pan_width" value="0.03" />

  <xacro:property name="tilt_radius" value="0.03" />
  <xacro:property name="tilt_width" value="0.06" />

  <xacro:property name="camera_base_height" value="0.06" />
  <xacro:property name="camera_base_length" value="0.02" />
  <xacro:property name="camera_base_width" value="0.06" />

  <xacro:property name="camera_lens_radius" value="0.02" />
  <xacro:property name="camera_lens_width" value="0.02" />

  <!-- Robot offsets -->
  <xacro:property name="caster_offset_z" value="${-body_height / 2 - caster_radius}" />
  <xacro:property name="caster_offset_x" value="${body_length / 2 - caster_radius * 2}" />

  <xacro:property name="wheel_offset_x" value="${-body_length / 2 + wheel_radius}" />
  <xacro:property name="wheel_offset_y" value="${body_width / 2 + wheel_width / 2}" />
  <xacro:property name="wheel_offset_z" value="${body_height / 2 - wheel_radius}" />


  <xacro:property name="pan_offset_z" value="${body_height / 2 + pan_width / 2}" />
  <xacro:property name="pan_offset_x" value="${body_length / 2 - pan_radius * 3}" />

  <xacro:property name="tilt_offset_z" value="${pan_width / 2 + tilt_radius}" />

  <xacro:property name="camera_base_offset_x" value="${tilt_radius + camera_base_length / 2}" />

  <xacro:property name="camera_lens_offset_x" value="${camera_base_length / 2 + camera_lens_width / 2}" />

  <!-- Rotate axis -->
  <xacro:property name="rotate_quarter" value="1.57079632679" />

  <!-- Wheel rotation axis -->
  <xacro:property name="wheel_joint_axis" value="1" />

  <xacro:property name="pan_joint_axis" value="1" />

  <xacro:property name="tilt_joint_axis" value="1" />
  
  <!-- Robot Mass -->
  <xacro:property name="body_mass" value="1.5" />

  <xacro:property name="wheel_mass" value="0.2" />

  <xacro:property name="caster_mass" value="0.04" />

  <xacro:property name="pan_mass" value="0.12" />
  
  <xacro:property name="tilt_mass" value="0.12" />

  <xacro:property name="camera_base_mass" value="0.08" />

  <xacro:property name="camera_lens_mass" value="0.04" />
</robot>
