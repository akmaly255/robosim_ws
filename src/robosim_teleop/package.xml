<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robosim_teleop</name>
  <version>1.0.1</version>
  <description>This is a package for controlling mobile robot differential drive in Gazebo Sim using generic joystick.</description>
  <maintainer email="akmaly255@gmail.com">Akmal Y</maintainer>
  <license>Apache License 2.0</license>
  
  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>  
  <depend>sensor_msgs</depend>
  <depend>trajectory_msgs</depend>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <exec_depend>joy</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
